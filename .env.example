# Use mock until the external providers are configured.
PROVIDER_MODE=mock

# Add when Loop 1 is connected to a Neon branch.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Add both values to enable Clerk. Keep secrets in .env.local or deployment settings.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Add both values together. The browser key is referrer-restricted; the server
# key is restricted to Geocoding API and Places API (New).
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=AIza...
# GOOGLE_MAPS_SERVER_KEY=AIza...
