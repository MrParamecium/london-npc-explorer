# Use mock until the external providers are configured.
PROVIDER_MODE=mock

# Add when Loop 1 is connected to a Neon branch.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Add both values to enable Clerk. Keep secrets in .env.local or deployment settings.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Add both values together. The browser key is referrer-restricted; the server
# key is restricted to Geocoding API and Places API (New).
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=AIza...
# GOOGLE_MAPS_SERVER_KEY=AIza...

# Add the server-only Moonshot key to enable NPC dialogue. The model is
# optional and defaults to kimi-k3.
# MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=kimi-k3

# OpenRouter remains available for the later GPT Image 2 portrait loop.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4.1-mini
